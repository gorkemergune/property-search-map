# Copy to .env.local and fill in. .env.local is git-ignored.
#
# HomeData (https://homedata.co.uk) free developer key, created with the company email.
# Used only by the Vite dev-server proxy (/api/homedata), never shipped to the browser.
HOMEDATA_API_KEY=
# Set to true once the key above is filled, so the app calls the proxy.
VITE_HOMEDATA_ENABLED=false
